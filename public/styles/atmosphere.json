{
  "version": 8,
  "name": "Enhanced Globe with Stars and Terrain",
  "center": [15, 50],
  "zoom": 1,
  "bearing": 0,
  "pitch": 0,
  "fog": {
    "range": [1, 1],
    "color": "hsl(0, 0%, 100%)",
    "high-color": [
      "interpolate",
      ["exponential", 1.2],
      ["zoom"],
      0,
      "hsl(207, 100%, 50%)",
      8,
      "hsl(38, 63%, 84%)"
    ],
    "space-color": [
      "interpolate",
      ["exponential", 1.2],
      ["zoom"],
      5.5,
      "hsl(199, 51%, 25%)",
      6,
      "hsl(199, 61%, 87%)"
    ],
    "horizon-blend": [
      "interpolate",
      ["exponential", 1.2],
      ["zoom"],
      5.5,
      0.05,
      6,
      0.1
    ],
    "star-intensity": [
      "interpolate",
      ["exponential", 1.2],
      ["zoom"],
      0,
      0.8,
      4,
      0.6,
      5.5,
      0.4,
      6,
      0.2,
      8,
      0
    ]
  },
  "sources": {
    "composite": {
      "url": "mapbox://mapbox.mapbox-bathymetry-v2,mapbox.mapbox-streets-v8,mapbox.mapbox-terrain-v2",
      "type": "vector"
    }
  },
  "sprite": "mapbox://sprites/mapbox-map-design/cl5uudydd000314qosrbmugax/etlcan5hezaaaphuizkskdjuw",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "projection": { "name": "globe" },
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": {
        "background-color": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          "hsl(199, 61%, 87%)",
          11,
          "hsl(35, 12%, 89%)"
        ]
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "maxzoom": 12,
      "filter": [
        "match",
        ["get", "class"],
        ["wood", "grass", "scrub", "crop", "snow"],
        true,
        false
      ],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "hsl(104, 45%, 65%)",
          "grass",
          "hsl(99, 40%, 75%)",
          "scrub",
          "hsl(99, 35%, 70%)",
          "crop",
          "hsl(67, 45%, 80%)",
          "snow",
          "hsl(0, 0%, 95%)",
          "hsl(35, 12%, 89%)"
        ],
        "fill-opacity": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          0,
          0.8,
          4,
          0.7,
          8,
          0.6,
          12,
          0.4
        ]
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "minzoom": 2,
      "filter": [
        "match",
        ["get", "class"],
        ["park", "agriculture", "wood", "grass", "scrub", "glacier", "sand"],
        true,
        false
      ],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "hsl(104, 50%, 60%)",
          "park",
          "hsl(99, 55%, 68%)",
          "agriculture",
          "hsl(67, 50%, 78%)",
          "grass",
          "hsl(99, 45%, 72%)",
          "scrub",
          "hsl(99, 35%, 65%)",
          "glacier",
          "hsl(0, 0%, 98%)",
          "sand",
          "hsl(35, 65%, 75%)",
          "hsl(35, 12%, 89%)"
        ],
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2,
          0.6,
          6,
          0.5,
          10,
          0.3
        ]
      }
    },
    {
      "id": "hillshade",
      "type": "fill",
      "source": "composite",
      "source-layer": "hillshade",
      "maxzoom": 16,
      "filter": ["match", ["get", "level"], [89, 78, 67, 56], true, false],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "shadow",
          "hsla(30, 20%, 40%, 0.15)",
          "hsla(35, 25%, 85%, 0.12)"
        ],
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          0.4,
          8,
          0.3,
          14,
          0.1,
          16,
          0
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": {
        "fill-color": "hsl(196, 80%, 70%)"
      }
    },
    {
      "id": "water-depth",
      "type": "fill",
      "source": "composite",
      "source-layer": "depth",
      "maxzoom": 8,
      "paint": {
        "fill-antialias": false,
        "fill-color": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          [
            "interpolate",
            ["linear"],
            ["get", "min_depth"],
            0,
            "hsla(196, 80%, 70%, 0.35)",
            200,
            "hsla(196, 80%, 63%, 0.35)",
            7000,
            "hsla(196, 80%, 56%, 0.35)"
          ],
          8,
          [
            "interpolate",
            ["linear"],
            ["get", "min_depth"],
            0,
            "hsla(196, 80%, 70%, 0)",
            200,
            "hsla(196, 80%, 63%, 0)",
            7000,
            "hsla(196, 80%, 53%, 0)"
          ]
        ]
      }
    }
  ]
}
